WITH RankedSkus AS (
SELECT 
soi.sku,
soi.name,
ROW_NUMBER() OVER (PARTITION BY soi.sku ORDER BY so.created_at DESC) as latest_rank
FROM sales_order so
JOIN sales_order_item soi 
ON so.entity_id = soi.order_id
LEFT JOIN category_table_mapping_india ctm 
ON (CASE 
WHEN right(soi.sku, 3) = '-IN' THEN left(soi.sku, length(soi.sku) - 3)
ELSE soi.sku
END) = ctm.sku
WHERE so.status IN ('complete', 'processing', 'delivered', 'Packed', 
'shipped', 'in-transit', 'dispatching_process', 
'partial_delivered', 'out-for-delivery')
AND so.created_at >= '2024-04-01'
AND so.store_id = '1'
AND soi.base_price > 0
AND ctm.l1 IS NULL)
SELECT 
sku,
name
FROM RankedSkus
WHERE latest_rank = 1
ORDER BY sku;

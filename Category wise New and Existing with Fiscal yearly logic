with fiscal_year_start as (
select
date '2026-04-01' as fy_start,
date '2027-04-01' as fy_end),

first_purchase as (
select
customer_email,
min(created_at) as first_ever_order_date
from sales_order
where status in ('complete', 'processing', 'delivered', 'Packed', 'shipped',
'in-transit', 'dispatching_process', 'partial_delivered', 'out-for-delivery')
and store_id = 1
group by customer_email),

first_day_in_fy_cte as (
select
so.customer_email,
min(date(so.created_at)) as first_day_in_fy
from sales_order so
cross join fiscal_year_start fys
where so.status in ('complete', 'processing', 'delivered', 'Packed', 'shipped',
'in-transit', 'dispatching_process', 'partial_delivered', 'out-for-delivery')
and so.store_id = 1
and so.created_at >= fys.fy_start
and so.created_at < current_date
group by so.customer_email),

-- first ever purchase date per customer per l1_category (all time, not just FY)
first_category_purchase as (
select
so.customer_email,
ctm.l1 as l1_category,
min(so.created_at) as first_category_order_date
from sales_order so
join sales_order_item soi
on so.entity_id = soi.order_id
left join category_table_mapping_india ctm
on case
when right(soi.sku, 3) = '-IN' then left(soi.sku, length(soi.sku) - 3)
else soi.sku
end = ctm.sku
where so.status in ('complete', 'processing', 'delivered', 'Packed', 'shipped',
'in-transit', 'dispatching_process', 'partial_delivered', 'out-for-delivery')
and so.store_id = 1
and soi.base_price > 0
group by so.customer_email, ctm.l1),

orders_with_customer_type as (
select
so.entity_id as order_id,
so.customer_email,
so.created_at::date as order_date,
so.grand_total,
soi.sku,
soi.name,
soi.qty_ordered,
soi.base_price,
(soi.qty_ordered * soi.base_price) as product_revenue,
ctm.l1 as l1_category,
-- fy-level new/existing (unchanged from your original)
case
when fp.first_ever_order_date >= fys.fy_start
and fp.first_ever_order_date < fys.fy_end then 'New'
else 'Existing'
end as fy_customer_type,
-- category-level new/existing
case
when fcp.first_category_order_date >= fys.fy_start
and fcp.first_category_order_date < fys.fy_end then 'New'
else 'Existing'
end as category_customer_type,
fd.first_day_in_fy
from sales_order so
join sales_order_item soi
on so.entity_id = soi.order_id
join first_purchase fp
on so.customer_email = fp.customer_email
join first_day_in_fy_cte fd
on so.customer_email = fd.customer_email
left join category_table_mapping_india ctm
on case
when right(soi.sku, 3) = '-IN' then left(soi.sku, length(soi.sku) - 3)
else soi.sku
end = ctm.sku
left join first_category_purchase fcp
on so.customer_email = fcp.customer_email
and ctm.l1 = fcp.l1_category
cross join fiscal_year_start fys
where so.status in ('complete', 'processing', 'delivered', 'Packed', 'shipped',
'in-transit', 'dispatching_process', 'partial_delivered', 'out-for-delivery')
and so.store_id = 1
and soi.base_price > 0
and so.created_at >= '2026-04-01'
and so.created_at < current_date),

order_subtotals as (
select
order_id,
sum(product_revenue) as order_subtotal
from orders_with_customer_type
group by order_id)

select
to_char(date_trunc('month', owct.order_date), 'MM-YYYY') as order_month,
owct.l1_category,
owct.fy_customer_type,
owct.category_customer_type,
count(distinct owct.order_id) as orders,
count(distinct owct.customer_email) as customers,
count(distinct case when owct.order_date = owct.first_day_in_fy
then owct.customer_email end) as unique_customers,
round(sum((owct.product_revenue / nullif(os.order_subtotal, 0)) * owct.grand_total), 0) as revenue
from orders_with_customer_type owct
join order_subtotals os
on owct.order_id = os.order_id
where os.order_subtotal > 0
group by date_trunc('month', owct.order_date), owct.l1_category, owct.fy_customer_type, owct.category_customer_type
order by date_trunc('month', owct.order_date) asc, owct.l1_category, owct.fy_customer_type desc limit 10000;

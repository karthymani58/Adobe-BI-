with fiscal_year_start as (
select 
date '2026-04-01' as fy_start,
date '2027-04-01' as fy_end),

first_purchase as (
select 
customer_email,
min(created_at) as first_ever_order_date
from sales_order
where status in ('complete','processing','delivered','Packed','shipped',
'in-transit','dispatching_process','partial_delivered','out-for-delivery')
and store_id = 1
group by customer_email),

first_day_in_fy_cte as (
select 
so.customer_email,
min(date(so.created_at)) as first_day_in_fy
from sales_order so
cross join fiscal_year_start fys
where so.status in ('complete','processing','delivered','Packed','shipped',
'in-transit','dispatching_process','partial_delivered','out-for-delivery')
and so.store_id = 1
and so.created_at >= fys.fy_start
and so.created_at < current_date
group by so.customer_email),

orders_with_customer_type as (
select 
so.increment_id as order_id,
so.customer_email,
so.grand_total as revenue,
date(so.created_at) as order_date,
case 
when fp.first_ever_order_date >= fys.fy_start 
and fp.first_ever_order_date < fys.fy_end 
then 'New'
else 'Existing'
end as customer_type,
fd.first_day_in_fy   -- comes from the new CTE, always Apr 1 based
from sales_order so
inner join first_purchase fp 
on so.customer_email = fp.customer_email
inner join first_day_in_fy_cte fd  -- join the new CTE
on so.customer_email = fd.customer_email
cross join fiscal_year_start fys
where so.status in ('complete','processing','delivered','Packed','shipped',
'in-transit','dispatching_process','partial_delivered','out-for-delivery')
and so.store_id = 1
and so.created_at >= '2026-10-01'
and so.created_at < current_date)

select 
order_date,
customer_type,
count(distinct order_id) as orders,
count(distinct customer_email) as customers,
count(distinct case when order_date = first_day_in_fy 
then customer_email end) as unique_customers,
sum(revenue) as revenue
from orders_with_customer_type
where customer_type in ('New', 'Existing')
group by order_date, customer_type
order by order_date, customer_type desc;

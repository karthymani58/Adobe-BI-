first_purchase as (
select customer_email, min(created_at) as first_ever_order_date
from sales_order
where status in ('complete', 'processing', 'delivered', 'Packed', 'shipped',
'in-transit', 'dispatching_process', 'partial_delivered', 'out-for-delivery')
and store_id = 1
group by customer_email),

first_hero_product_purchase as (
select so.customer_email,
hps.hero_product,
min(so.created_at) as first_hero_purchase_date
from sales_order so
join sales_order_item soi on so.entity_id = soi.order_id
join hero_product_skus hps
on regexp_replace(regexp_replace(soi.sku, '-IN$', ''), 'old$', '') = hps.sku
where so.status in ('complete', 'processing', 'delivered', 'Packed', 'shipped',
'in-transit', 'dispatching_process', 'partial_delivered', 'out-for-delivery')
and so.store_id = 1
and soi.base_price > 0
group by so.customer_email, hps.hero_product),

first_hero_purchase_in_fy as (
select so.customer_email,
hps.hero_product,
min(so.created_at) as first_hero_purchase_in_fy_date
from sales_order so
join sales_order_item soi on so.entity_id = soi.order_id
join hero_product_skus hps
on regexp_replace(regexp_replace(soi.sku, '-IN$', ''), 'old$', '') = hps.sku
cross join fiscal_year_start fys
where so.status in ('complete', 'processing', 'delivered', 'Packed', 'shipped',
'in-transit', 'dispatching_process', 'partial_delivered', 'out-for-delivery')
and so.store_id = 1
and soi.base_price > 0
and so.created_at >= fys.fy_start
and so.created_at < fys.fy_end
group by so.customer_email, hps.hero_product),

-- NEW: full order subtotal across ALL items in the order, not just hero items
order_full_subtotal as (
select so.entity_id as order_id,
sum(soi.qty_ordered * soi.base_price) as full_order_subtotal
from sales_order so
join sales_order_item soi on so.entity_id = soi.order_id
where so.status in ('complete', 'processing', 'delivered', 'Packed', 'shipped',
'in-transit', 'dispatching_process', 'partial_delivered', 'out-for-delivery')
and so.store_id = 1
and soi.base_price > 0
group by so.entity_id),

orders_with_customer_type as (
select so.entity_id as order_id,
so.customer_email,
so.created_at::date as order_date,
to_char(so.created_at, 'yyyy-mm') as order_month,
so.grand_total,
soi.sku,
soi.name,
soi.qty_ordered,
soi.base_price,
(soi.qty_ordered * soi.base_price) as product_revenue,
hps.hero_product,
case
when fhp.first_hero_purchase_date >= fys.fy_start
and fhp.first_hero_purchase_date < fys.fy_end then 'New'
else 'Existing'
end as hero_product_customer_type,
fhpfy.first_hero_purchase_in_fy_date
from sales_order so
join sales_order_item soi on so.entity_id = soi.order_id
join hero_product_skus hps
on regexp_replace(regexp_replace(soi.sku, '-IN$', ''), 'old$', '') = hps.sku
join first_purchase fp on so.customer_email = fp.customer_email
join first_hero_product_purchase fhp
on so.customer_email = fhp.customer_email
and hps.hero_product = fhp.hero_product
join first_hero_purchase_in_fy fhpfy
on so.customer_email = fhpfy.customer_email
and hps.hero_product = fhpfy.hero_product
cross join fiscal_year_start fys
where so.status in ('complete', 'processing', 'delivered', 'Packed', 'shipped',
'in-transit', 'dispatching_process', 'partial_delivered', 'out-for-delivery')
and so.store_id = 1
and soi.base_price > 0
and so.created_at >= fys.fy_start
and so.created_at < fys.fy_end)

select owct.order_month,
owct.hero_product,
owct.hero_product_customer_type,
count(distinct owct.order_id) as orders,
count(distinct owct.customer_email) as customers,
count(distinct case when owct.order_date = owct.first_hero_purchase_in_fy_date::date
then owct.customer_email end) as unique_customers,
round(sum((owct.product_revenue / nullif(ofs.full_order_subtotal, 0)) * owct.grand_total), 0) as revenue
from orders_with_customer_type owct
join order_full_subtotal ofs on owct.order_id = ofs.order_id
where ofs.full_order_subtotal > 0
group by owct.order_month, owct.hero_product, owct.hero_product_customer_type
order by owct.order_month asc, owct.hero_product, owct.hero_product_customer_type desc limit 10000;
